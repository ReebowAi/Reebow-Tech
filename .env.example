═══════════════════════════════════════════════════════════════════
# REEBOW TECH PLATFORM — ENVIRONMENT CONFIGURATION
# Copy to .env and fill in YOUR values. NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# CORE APPLICATION
# ─────────────────────────────────────────────────────────────────
NODE_ENV=development                    # production | development | test
PORT=10000                              # Internal port (Render/Railway maps 443→this)
APP_NAME=Reebow TECH
APP_URL=http://localhost:10000          # Your public HTTPS URL in production
API_PREFIX=/api                         # Base path for all API routes

# ─────────────────────────────────────────────────────────────────
# MONGODB ATLAS (Free tier: 512MB, shared RAM)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://reebow_user:CHANGE_ME@reebow-cluster.xxxxx.mongodb.net/reebow-platform?retryWrites=true&w=majority
MONGO_DB_NAME=reebow-platform           # Explicit DB name (optional, can be in URI)
MONGO_MAX_POOL_SIZE=10                  # Connection pool (Atlas free tier = 100)
MONGO_SERVER_SELECTION_MS=5000          # Fail fast if no primary
MONGO_SOCKET_TIMEOUT_MS=45000           # Operations timeout

# ─────────────────────────────────────────────────────────────────
# AUTHENTICATION & SESSIONS
# ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_128_CHAR_HEX_STRING
SESSION_NAME=reebow.sid
SESSION_MAX_AGE_MS=2592000000           # 30 days (30*24*60*60*1000)
SESSION_SECURE_COOKIES=true             # true in production (HTTPS only)
SESSION_SAME_SITE=lax                   # lax | strict | none (none requires secure)

# Admin access (single-tenant mode) — CHANGE IN PRODUCTION
ADMIN_EMAIL=admin@reebow.local
ADMIN_PASSWORD=Reeb911422@              # Minimum 12 chars, special chars
ADMIN_SESSION_TTL_MS=3600000            # 1 hour admin session

# ─────────────────────────────────────────────────────────────────
# SECURITY & HARDENING
# ─────────────────────────────────────────────────────────────────
HELMET_CSP_ENABLED=true                 # Content Security Policy
CORS_ORIGIN=https://yourdomain.com      # Comma-separated list, or * for dev
RATE_LIMIT_WINDOW_MS=900000             # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100             # Per IP per window
LOGIN_RATE_LIMIT_MAX=5                  # Login attempts per window
LOGIN_RATE_LIMIT_WINDOW_MS=900000       # 15 minutes
TRUST_PROXY=true                        # Required behind Render/Railway/Cloudflare

# ─────────────────────────────────────────────────────────────────
# SOCKET.IO & REALTIME
# ─────────────────────────────────────────────────────────────────
SOCKET_PING_INTERVAL=10000              # Heartbeat interval (ms)
SOCKET_PING_TIMEOUT=5000                # Heartbeat timeout (ms)
SOCKET_UPGRADE_TIMEOUT=30000            # WebSocket upgrade timeout
SOCKET_MAX_PAYLOAD_BYTES=1048576        # 1MB max message size
SOCKET_ALLOW_EIO3=false                 # Force Socket.io v4 protocol

# ─────────────────────────────────────────────────────────────────
# GEOLOCATION & LOCALIZATION
# ─────────────────────────────────────────────────────────────────
IP_API_URL=http://ip-api.com/json/      # Free tier: 45 req/min, no key needed
IP_API_FIELDS=country,city,region,lat,lon,timezone,isp,org,as,mobile,proxy,hosting,query
IP_API_TIMEOUT_MS=3000
DEFAULT_LANGUAGE=en                     # en | fr | es | ar | pt | etc.
SUPPORTED_LANGUAGES=en,fr               # Comma-separated

# ─────────────────────────────────────────────────────────────────
# VIDEO CALL & MEDIA (Pre-recorded clip injection mode)
# ─────────────────────────────────────────────────────────────────
VIDEO_CLIPS_BASE_URL=/clips             # Served from public/clips/ or CDN
VIDEO_CLIP_MANIFEST=clips/manifest.json # Auto-generated at build
DEFAULT_PERSONA=annie                   # annie | craig | etc.
DEFAULT_CLIP_HELLO=hello                # Clip ID for greeting
DEFAULT_CLIP_LISTENING=listening        # Clip ID for "listening" loop
DEFAULT_CLIP_THINKING=thinking          # Clip ID for "thinking" loop

# ─────────────────────────────────────────────────────────────────
# PAYMENT & PROVISIONING (Multi-tenant SaaS)
# ─────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_HMAC_SECRET
PROVISION_ON_PAYMENT=true               # Auto-create tenant on webhook
DEFAULT_ADMIN_PASSWORD_PREFIX=Support_  # + random 8 chars
DEFAULT_TENANT_STATUS=ACTIVE            # PENDING | ACTIVE | SUSPENDED

# NOWPayments (crypto)
NOWPAYMENTS_IPN_SECRET=your_ipn_secret
NOWPAYMENTS_API_KEY=your_api_key

# Stripe (cards) — optional
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# Paystack (Africa) — optional
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_WEBHOOK_SECRET=...

# ─────────────────────────────────────────────────────────────────
# HOTLINES & CONTACT (Displayed in visitor UI)
# ─────────────────────────────────────────────────────────────────
HOTLINE_PRIMARY=+234 814 674 2186
HOTLINE_SECONDARY=+1 581 809 6580
HOTLINE_WHATSAPP=+2348146742186         # E.164 format for wa.me links
SUPPORT_EMAIL=support@reebow.tech
BUSINESS_NAME=Reebow TECH

# ─────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info                          # error | warn | info | http | debug
LOG_FORMAT=json                         # json | simple (production = json)
LOG_DIR=./logs                          # Must be writable

# ─────────────────────────────────────────────────────────────────
# MAINTENANCE & CLEANUP
# ─────────────────────────────────────────────────────────────────
MAINT_INTERVAL_MS=86400000              # 24 hours
MAINT_MAX_CALL_LOG_AGE_DAYS=90
MAINT_MAX_MESSAGE_AGE_DAYS=365
MAINT_MAX_TEMP_FILE_AGE_HOURS=6
MEMORY_WATCHDOG_MB=512                  # Restart if RSS exceeds this (MB)
CRON_SSL_RENEWAL=0 3 * * *              # Daily 3AM (handled by platform usually)

# ─────────────────────────────────────────────────────────────────
# PWA & CACHE
# ─────────────────────────────────────────────────────────────────
PWA_APP_NAME=Reebow Messenger
PWA_SHORT_NAME=Reebow
PWA_THEME_COLOR=#0b0f19
PWA_BACKGROUND_COLOR=#0b0f19
SW_CACHE_VERSION=v2.0.0                 # Bump to invalidate caches on deploy

# ─────────────────────────────────────────────────────────────────
# DEVELOPMENT OVERRIDES (Ignored when NODE_ENV=production)
# ─────────────────────────────────────────────────────────────────
DEV_ALLOW_HTTP=true
DEV_DISABLE_RATE_LIMIT=false
DEV_MOCK_GEO=true                       # Skip ip-api calls in dev
DEV_MOCK_GEO_COUNTRY=US
DEV_MOCK_GEO_CITY=San FranciscoUsage# 1. Copy template
cp .env.example .env

# 2. Generate strong secrets (run in terminal)
node -e "console.log('SESSION_SECRET=' + require('crypto').randomBytes(64).toString('hex'))"
node -e "console.log('WEBHOOK_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"

# 3. Fill in YOUR values:
#    - MONGO_URI (Atlas connection string)
#    - ADMIN_PASSWORD (change from default!)
#    - CORS_ORIGIN (your production domain)
#    - Payment keys (if using monetization)
#    - HOTLINE numbers (your real numbers)

